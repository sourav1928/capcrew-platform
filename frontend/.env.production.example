# CapCrew shop + admin site, LIVE settings. Copy to frontend/.env.production BEFORE running
#   npm run build         (the shop)
#   npm run build:admin   (the admin site)
# These values are baked into the built files, so never put secrets here.

# Your API address, ending in /api/v1
VITE_API_URL=https://api.yourshop.com/api/v1

# Used by the admin site for the "view shop" links
VITE_SHOP_URL=https://yourshop.com

# Social media links in the shop footer. Leave blank to hide an icon.
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_TWITTER=
VITE_SOCIAL_INSTAGRAM=
