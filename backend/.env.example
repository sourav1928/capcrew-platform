# Django Secret Key
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production

# Environment
DEBUG=True
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://capcrew:capcrew@localhost:5432/capcrew_db

# Redis
REDIS_URL=redis://localhost:6379/3
CELERY_BROKER_URL=redis://localhost:6379/4
CELERY_RESULT_BACKEND=redis://localhost:6379/5

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5175,http://localhost:3000

# Email - Brevo (Sendinblue) Configuration
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key-here
BREVO_ENABLED=True

# Default Email Settings (fallback)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@capcrew.local

# Business Configuration
BUSINESS_NAME=CapCrew
BUSINESS_EMAIL=support@capcrew.local
BUSINESS_PHONE=+91-XXXXXXXXXX
BUSINESS_GST_IN=

# JWT Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_LIFETIME_HOURS=1
REFRESH_TOKEN_LIFETIME_DAYS=7

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_RESEND_LIMIT=3

# Payment Gateway (Razorpay)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AWS S3 (Optional)
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Sentry (Optional Error Tracking)
SENTRY_ENABLED=False
SENTRY_DSN=

# Stock Management
STOCK_RESERVATION_EXPIRY_MINUTES=15
ALLOW_BACKORDER=False

# Returns & Refunds
DEFAULT_RETURN_WINDOW_DAYS=7
DEFAULT_WARRANTY_DAYS=365

# COD Configuration
ENABLE_COD=True
MAX_COD_ORDER_VALUE=100000

# ---- Security switches (all are safe by default; they only matter on a live site) ----
# See .env.production.example for the full list of settings a live site needs.
# ALLOW_MOCK_PAYMENTS, EXPOSE_OTP_IN_RESPONSE and ENABLE_API_DOCS default to ON only while DEBUG=True.
# DJANGO_ADMIN_URL=admin/
# NUM_PROXIES=0
