# =====================================================================
#  CapCrew - LIVE SITE settings.  Copy this file to backend/.env on the server
#  (name it exactly ".env"), fill in EVERY value, then run:
#     python manage.py check --deploy
#  Never put this file in git, email it, or share it: it holds your secrets.
# =====================================================================

DEBUG=False
ENVIRONMENT=production

# A long random value. Create one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The site refuses to start with a short or default key.
DJANGO_SECRET_KEY=

# Where the Django admin lives. Choose a secret address only you know, ending with a slash.
# Example: DJANGO_ADMIN_URL=manage-7f3k2x/
DJANGO_ADMIN_URL=

# Your real website addresses (https only, no trailing slash)
ALLOWED_HOSTS=api.yourshop.com
CORS_ALLOWED_ORIGINS=https://yourshop.com
ADMIN_FRONTEND_ORIGINS=https://admin.yourshop.com
CSRF_TRUSTED_ORIGINS=https://yourshop.com,https://admin.yourshop.com,https://api.yourshop.com

# Number of reverse proxies in front of Django (nginx = 1). Needed so login limits see real visitor addresses.
NUM_PROXIES=1

# Database: use a STRONG password, not "capcrew"
DATABASE_URL=postgresql://capcrew:CHANGE_THIS_STRONG_PASSWORD@localhost:5432/capcrew_db

# Redis (rate limits, cache, background jobs)
REDIS_URL=redis://localhost:6379/3
CELERY_BROKER_URL=redis://localhost:6379/4
CELERY_RESULT_BACKEND=redis://localhost:6379/5

# Email (sign-up codes and order emails). Use a Brevo key made for THIS store.
BREVO_ENABLED=True
BREVO_API_KEY=
# Must be ONE plain email address (no name, no < >) that you have verified as a Sender in Brevo.
# Prefer an address on your own domain; free Gmail/Yahoo addresses are restricted as senders.
DEFAULT_FROM_EMAIL=orders@yourshop.com

# Business details shown on invoices and emails
BUSINESS_NAME=CapCrew
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_GST_IN=

# Online payments (Razorpay LIVE keys). Without these, only Cash on Delivery is offered.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Settings -> Webhooks -> add  https://api.yourshop.com/api/v1/payments/webhook/razorpay/
# for the event "payment.captured", and paste the secret you chose here:
RAZORPAY_WEBHOOK_SECRET=

# Product photos. Needed on hosts where the disk is erased on every restart (Render, Heroku...).
# Example for Supabase Storage (see deploy/DEPLOYMENT.md, section "Product photos"):
USE_S3=False
AWS_STORAGE_BUCKET_NAME=media
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# the public address of the bucket WITHOUT https://, e.g.  <project-ref>.supabase.co/storage/v1/object/public/media
AWS_S3_CUSTOM_DOMAIN=

# Error reports (optional but recommended): https://sentry.io
SENTRY_ENABLED=False
SENTRY_DSN=

# ---------------------------------------------------------------------
# DO NOT add these on a live site (the site refuses to start if you do):
#   ALLOW_MOCK_PAYMENTS   EXPOSE_OTP_IN_RESPONSE   ENABLE_API_DOCS
# ---------------------------------------------------------------------
